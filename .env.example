# URL of the upstream OpenAI-compatible API (e.g. http://localhost:11434/v1 for Ollama)
UPSTREAM_BASE_URL=https://api.openai.com/v1

# API key forwarded to the upstream provider
UPSTREAM_API_KEY=sk-...

# Cosine similarity threshold for cache hits (0.0–1.0, default 0.92)
SIMILARITY_THRESHOLD=0.92

# SQLite cache file path
CACHE_DB_PATH=cache.db

# Cache TTL in seconds (default 86400 = 24 h)
CACHE_TTL_SECONDS=86400

# Path to the YAML routing config (maps tier names to model IDs)
ROUTES_CONFIG_PATH=config/routes.yaml

# Informational: actual complexity thresholds live in routes.yaml, not here
COMPLEXITY_THRESHOLD=50

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
