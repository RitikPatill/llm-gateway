# URL of the upstream OpenAI-compatible API (e.g. http://localhost:11434/v1 for Ollama)
UPSTREAM_BASE_URL=https://api.openai.com/v1

# API key forwarded to the upstream provider
UPSTREAM_API_KEY=sk-...

# Cosine similarity threshold for cache hits (0.0–1.0, default 0.95)
SIMILARITY_THRESHOLD=0.95

# Token count threshold below which requests are downgraded to the cheap model
COMPLEXITY_THRESHOLD=200

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
